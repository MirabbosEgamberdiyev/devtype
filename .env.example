# ==========================================
# DevType Muhit Sozlamalari (.env.example)
# ==========================================

# Muhit rejimi: local, ci, staging, prod
SPRING_PROFILES_ACTIVE=local

# Server & Tarmoq
PORT=8080
APP_BASE_URL=http://localhost:5173
TRUSTED_PROXIES=127.0.0.1

# PostgreSQL Baza sozlamalari
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devtype
DB_USER=devtype_app
DB_PASSWORD=devtype_app_password
DB_MIGRATOR_USER=devtype_migrator
DB_MIGRATOR_PASSWORD=devtype_migrator_password
DB_URL=jdbc:postgresql://localhost:5432/devtype

# JWT Kalitlari (RS256)
# Local ishlab chiqish uchun test kalitlari (production'da maxfiy xotiradan yuklanadi)
JWT_ISSUER=https://auth.devtype.dev
JWT_AUDIENCE=https://api.devtype.dev
JWT_PRIVATE_KEY=classpath:keys/jwt-local-private.pem
JWT_PUBLIC_KEYS=kid1:classpath:keys/jwt-local-public.pem

# HMAC & Shifrlash Sirlari
HMAC_COMPLETE_TOKEN_KEY=local-dev-hmac-complete-token-secret-minimum-32-bytes
HMAC_GUEST_TOKEN_KEY=local-dev-hmac-guest-token-secret-minimum-32-bytes
TOTP_ENCRYPTION_KEY=local-dev-totp-encryption-secret-32-bytes!

# OAuth (Mahalliy stub yoki haqiqiy)
OAUTH_GITHUB_CLIENT_ID=mock-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=mock-github-client-secret
OAUTH_GOOGLE_CLIENT_ID=mock-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=mock-google-client-secret

# Email (SMTP / Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@devtype.dev

# Obyekt xotirasi (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=devtype-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
AVATAR_PUBLIC_BASE_URL=http://localhost:9000/devtype-media/avatars

# AI Coach (R3)
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=claude-3-5-haiku-20241022
LLM_MONTHLY_BUDGET=100.00

# Monitoring & Error Reporting
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Feature Flags (R1 da: SPEED_TEST, PRACTICE, ACCURACY, SPECIAL_CHARS yoqiq)
DEVTYPE_MODES_SPEED_TEST=true
DEVTYPE_MODES_PRACTICE=true
DEVTYPE_MODES_ACCURACY=true
DEVTYPE_MODES_SPECIAL_CHARS=true
DEVTYPE_MODES_WEAKNESS=false
DEVTYPE_MODES_CHALLENGE=false
DEVTYPE_MODES_CODE_SPRINT=false
DEVTYPE_FEATURES_COACH=false
DEVTYPE_FEATURES_LEADERBOARDS=false
DEVTYPE_FEATURES_ACHIEVEMENTS=false
DEVTYPE_FEATURES_CHALLENGES=false
DEVTYPE_FEATURES_COMPETITIONS=false
