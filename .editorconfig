root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,groovy,gradle,kt,kts}]
indent_size = 4
max_line_length = 120

[*.{ts,tsx,js,jsx,json,css,scss,html}]
indent_size = 2
max_line_length = 100

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = 120

[Makefile]
indent_style = tab
